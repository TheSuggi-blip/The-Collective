#!/bin/sh
# ASCII guard - local layer. Auto-fixes non-ASCII in staged files.
#
# Behavior:
#   1. Scans staged files for non-ASCII bytes.
#   2. Prints the offending file:line so the author sees the mistake.
#   3. Auto-sanitizes via scripts/sanitize-ascii.py and re-stages.
#   4. Commits proceed with pure-ASCII content.
#   5. If a file in game/planets/ or game/players/ is staged, runs
#      scripts/validate-intel.py and blocks the commit on an error.
#   6. If a file in game/fleet/ or game/routes/ is staged, runs
#      game/fleet/routes.py check and scripts/fleet-index.py --check and
#      blocks the commit on an error. The tests run in CI, not here.
#
# If the sanitizer script is missing, falls back to BLOCKING the commit
# (old behavior) so bad content can never be committed silently.

bad=0
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$f" in
    *.pdf|*.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.svg|*.zip|*.gz|*.tar|*.xlsx|*.docx|*.pptx|*.woff|*.woff2|*.ttf|*.otf|*.mp3|*.mp4|*.mov|*.bin) continue ;;
  esac
  if ! grep -qI . "$f" 2>/dev/null; then
    continue
  fi
  if LC_ALL=C grep -nP "[^\x00-\x7F]" "$f" >/dev/null 2>&1; then
    echo ""
    echo "ASCII GUARD: non-ASCII found in: $f"
    LC_ALL=C grep -nP "[^\x00-\x7F]" "$f" | head -n 5
    if [ -f scripts/sanitize-ascii.py ]; then
      python3 scripts/sanitize-ascii.py "$f"
      git add "$f"
      echo "  -> auto-sanitized to pure ASCII and re-staged: $f"
    else
      echo "COMMIT BLOCKED: fix the non-ASCII characters above, then commit again."
      echo "(scripts/sanitize-ascii.py not found - install it for auto-fix)"
      bad=1
    fi
  fi
done
if [ "$bad" -ne 0 ]; then
  echo ""
  echo "COMMIT BLOCKED: fix the non-ASCII characters above, then commit again."
  exit 1
fi

# Intel gate: a commit that touches game/planets/ or game/players/ needs every intel
# file to pass scripts/validate-intel.py (each folder's BLUEPRINT.md).
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^game/(planets|players)/'; then
  if [ -f scripts/validate-intel.py ]; then
    if ! python3 scripts/validate-intel.py; then
      echo ""
      echo "COMMIT BLOCKED: fix the intel files above, then commit again."
      exit 1
    fi
  fi
fi

# Route gate: only run routes.py check when route/plan JSON files or routes.py are staged
# (so guidebook markdown edits are never blocked by another member's untracked route files: ENT-119).
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(game/routes/([^/]+\.json|plans/[^/]+\.json)|game/fleet/routes\.py)$'; then
  if [ -f game/fleet/routes.py ]; then
    if ! python3 -B game/fleet/routes.py check; then
      echo ""
      echo "COMMIT BLOCKED: fix the routes above, then commit again."
      exit 1
    fi
  fi
fi

# Fleet index gate: only run fleet-index.py --check when fleet scripts or index.md are staged.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^game/fleet/([^/]+\.py|index\.md)$'; then
  if [ -f scripts/fleet-index.py ]; then
    if ! python3 -B scripts/fleet-index.py --check; then
      echo ""
      echo "COMMIT BLOCKED: rebuild the fleet index (python3 -B scripts/fleet-index.py), stage it, then commit again."
      exit 1
    fi
  fi
fi

# Guidebook gate: any staged change under game/routes/guidebook/ must pass scripts/guide.py check (caps, form, ASCII).
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^game/routes/guidebook/'; then
  if [ -f scripts/guide.py ]; then
    if ! python3 -B scripts/guide.py check; then
      echo ""
      echo "COMMIT BLOCKED: guidebook chapter over cap or malformed (refine/retire entries, then commit again)."
      exit 1
    fi
  fi
fi

# Needs & reserve gate: any staged change to game/needs.tsv or game/reserve.tsv must pass needs.py check.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^game/(needs|reserve)\.tsv$'; then
  if [ -f game/fleet/needs.py ]; then
    if ! python3 -B game/fleet/needs.py check; then
      echo ""
      echo "COMMIT BLOCKED: fix game/needs.tsv or game/reserve.tsv via needs.py, then commit again."
      exit 1
    fi
  fi
fi

# Comms log gate: any staged change to communications/*.log must pass scripts/comms.py check.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^communications/[^/]+\.log$'; then
  if [ -f scripts/comms.py ]; then
    if ! python3 -B scripts/comms.py check; then
      echo ""
      echo "COMMIT BLOCKED: communications log failed scripts/comms.py check."
      exit 1
    fi
  fi
fi
exit 0
